# From @BotFather
BOT_TOKEN=

# Dashboard login (username defaults to "admin")
ADMIN_PASSWORD=
# ADMIN_USER=admin

# Private channel used to back up the bot's state, e.g. -1001234567890
# Required on Render: its free disk is wiped on every restart.
STORAGE_CHAT_ID=

# Only needed outside Render. Render sets RENDER_EXTERNAL_URL automatically.
# Leave empty locally and the bot uses long polling instead of a webhook.
# PUBLIC_URL=https://example.com
